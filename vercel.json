{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/collections",
      "destination": "/collections/all",
      "permanent": false
    },
    {
      "source": "/products",
      "destination": "/collections/all",
      "permanent": false
    },
    {
      "source": "/blogs",
      "destination": "/blogs/journal",
      "permanent": false
    },
    {
      "source": "/policies",
      "destination": "/policies/privacy-policy",
      "permanent": false
    },
    {
      "source": "/pages",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
